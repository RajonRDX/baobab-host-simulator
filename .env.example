# Rajon Private Host Simulator Environment Configuration
APP_NAME="RAJON Private Host Simulator"
APP_ENV="development"
SECRET_KEY="change-this-to-a-secure-random-64-char-hex-string-in-production"
ADMIN_USERNAME="admin"
# Default password is: AdminPassword123! (hashed at startup if ADMIN_PASSWORD_HASH not set)
ADMIN_PASSWORD="AdminPassword123!"

# Database: Use SQLite for instant local testing, or Neon PostgreSQL URI for cloud/local Postgres
DATABASE_URL="sqlite:///./rajon_host.db"
# DATABASE_URL="postgresql+psycopg2://user:password@ep-xyz.aws.neon.tech/neondb?sslmode=require"

# Soft HSM Configuration
# Modes: "SOFT_HSM_LOCAL" (uses built-in Python port of your Thales 10K Soft-HSM)
#        "SOFT_HSM_REMOTE" (calls external Soft HSM HTTP/TCP endpoint)
#        "MOCK_SIMULATED" (clearly labeled simulation mode)
HSM_MODE="SOFT_HSM_LOCAL"
HSM_REMOTE_URL="http://127.0.0.1:8888/api/hsm_api"
HSM_HEADER_LENGTH=4

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"
